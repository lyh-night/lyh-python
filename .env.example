# 复制为 .env 并按需修改；.env 已被 .gitignore 排除，密钥不入库。

# ---- LLM（DeepSeek，OpenAI 兼容协议）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60

# ---- Agent ----
AGENT_RECURSION_LIMIT=25

# ---- 安全 ----
# 留空 = 关闭鉴权（仅限本地开发）；配置后请求需携带 Authorization: Bearer <token>
API_AUTH_TOKEN=
RATE_LIMIT_PER_MINUTE=30

# ---- 应用 ----
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai
